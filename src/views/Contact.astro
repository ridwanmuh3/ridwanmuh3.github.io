---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionHead from '../components/SectionHead.astro';
import { getContent } from '../data/index';
import { localizeHref } from '../lib/url';

import type { Lang } from '../config';

/** `/contact/` (Hugo's `contact/list.html`): section head plus the form. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'en' ? 'id' : 'en';
const meta = getContent(lang).pages.contact;
---

<BaseLayout
  lang={lang}
  title={meta.title}
  description={meta.body}
  path={localizeHref(lang, '/contact/')}
  translation={localizeHref(other, '/contact/')}
>
  <section class="flow flow-end">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-12">
      <div class="lg:sticky lg:top-24">
        <SectionHead level="h1" title={meta.title} body={meta.body} />
      </div>
      <ContactForm lang={lang} />
    </div>
  </section>
</BaseLayout>
