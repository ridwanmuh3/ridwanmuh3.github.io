---
import { render } from 'astro:content';

import ArticleLayout from '../layouts/ArticleLayout.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../data/index';
import { slugFromId } from '../lib/content';
import { readingTime } from '../lib/format';
import { localizeHref } from '../lib/url';

import type { Lang } from '../config';
import type { CollectionEntry } from 'astro:content';

/** Blog post (Hugo's `single.html`). */
interface Props {
  entry: CollectionEntry<'blog'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const other: Lang = lang === 'en' ? 'id' : 'en';
const slug = slugFromId(entry.id);
const back = getContent(lang).pages.blogs;
const { Content } = await render(entry);
const hasMermaid = entry.body?.includes('```mermaid') ?? false;
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  path={localizeHref(lang, `/blogs/${slug}/`)}
  kind="article"
  headline={entry.data.title}
  datePublished={entry.data.date.toISOString().slice(0, 10)}
  dateModified={entry.data.date.toISOString().slice(0, 10)}
  translation={localizeHref(other, `/blogs/${slug}/`)}
  lightbox={hasMermaid}
  mermaid={hasMermaid}
>
  <ArticleLayout
    lang={lang}
    title={entry.data.title}
    date={entry.data.date}
    description={entry.data.summary}
    minutes={readingTime(entry.body ?? '')}
    backHref={localizeHref(lang, '/blogs/')}
    backTitle={back.title}
  >
    <Content />
  </ArticleLayout>
</BaseLayout>
