---
import { render } from 'astro:content';

import ArticleLayout from '../layouts/ArticleLayout.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../data/index';
import { t } from '../i18n/ui';
import { slugFromId } from '../lib/content';
import { readingTime, enDash } from '../lib/format';
import { localizeHref } from '../lib/url';

import type { Lang } from '../config';
import type { CollectionEntry } from 'astro:content';

/** Project detail page (Hugo's `single.html`). */
interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const other: Lang = lang === 'en' ? 'id' : 'en';
const slug = slugFromId(entry.id);
const data = getContent(lang);
const back = data.pages.projects;
const card = data.projects.find((project) => project.url === `/projects/${slug}/`);
const { Content } = await render(entry);

const link = entry.data.link;
const minutes = link?.startsWith('http') ? undefined : readingTime(entry.body ?? '');
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  path={localizeHref(lang, `/projects/${slug}/`)}
  kind="article"
  headline={entry.data.title}
  datePublished={entry.data.date.toISOString().slice(0, 10)}
  dateModified={entry.data.date.toISOString().slice(0, 10)}
  translation={localizeHref(other, `/projects/${slug}/`)}
  lightbox
>
  <ArticleLayout
    lang={lang}
    title={entry.data.title}
    date={entry.data.date}
    link={link}
    photo={entry.data.photo}
    description={entry.data.description}
    minutes={minutes}
    backHref={localizeHref(lang, '/projects/')}
    backTitle={back.title}
  >
    {card && (card.type || card.duration || card.skills.length > 0) && (
      <dl slot="facts" class="grid gap-4 rounded-lg border border-line-raised bg-surface p-4 sm:grid-cols-3">
        {card.type && <div><dt class="type-meta">{t(lang, 'projectType')}</dt><dd class="type-label text-ink mt-2">{card.type}</dd></div>}
        {card.duration && <div><dt class="type-meta">{t(lang, 'projectTimeline')}</dt><dd class="type-label text-ink mt-2">{enDash(card.duration)}</dd></div>}
        {card.skills.length > 0 && <div><dt class="type-meta">{t(lang, 'projectStack')}</dt><dd class="text-sm text-ink mt-2 leading-relaxed">{card.skills.join(' · ')}</dd></div>}
      </dl>
    )}
    <Content />
  </ArticleLayout>
</BaseLayout>
