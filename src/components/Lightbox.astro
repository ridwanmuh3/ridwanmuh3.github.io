---
import Icon from './Icon.astro';
import { t } from '../i18n/ui';

import type { Lang } from '../config';

/**
 * Click-to-enlarge viewer for project screenshots (Hugo's `lightbox.html`).
 *
 * One `<dialog>` per page; every `[data-lightbox-src]` button hands it its own
 * image, so N screenshots cost one dialog and one script. Native dialog carries
 * the focus trap, the top layer and Escape for free — the script only swaps the
 * image and drives the zoom levels.
 *
 * Emits markup *and* script, so it must be included once per page. Pages with
 * no screenshot can skip it; the script also no-ops if no trigger is found.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dialog
  class="lightbox"
  data-lightbox-dialog
  data-lightbox-fit-label={t(lang, 'imageFit')}
  aria-label={t(lang, 'mediaViewer')}
>
  <div class="lightbox__frame" data-lightbox-frame>
    <div class="lightbox__stage" data-lightbox-stage>
      <img class="lightbox__img" data-lightbox-img alt="" decoding="async" />
    </div>
    <div class="lightbox__bar">
      <p class="lightbox__caption type-meta" data-lightbox-caption></p>
      <div class="lightbox__controls" role="group" aria-label={t(lang, 'imageZoom')}>
        <button type="button" data-lightbox-zoom="-1" aria-label={t(lang, 'imageZoomOut')}>
          <Icon name="minus" class="size-4" />
        </button>
        <button
          type="button"
          class="lightbox__level type-label"
          data-lightbox-reset
          aria-label={t(lang, 'imageFit')}
        >
          {t(lang, 'imageFit')}
        </button>
        <button type="button" data-lightbox-zoom="1" aria-label={t(lang, 'imageZoomIn')}>
          <Icon name="plus" class="size-4" />
        </button>
      </div>
    </div>
  </div>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label={t(lang, 'imageClose')}>
    <Icon name="close" class="size-5" />
  </button>
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox';

  initLightbox();
</script>
