---
import { getImage } from 'astro:assets';

import Icon from './Icon.astro';
import { getProjectImage } from '../lib/images';
import { t } from '../i18n/ui';

import type { Lang } from '../config';

/**
 * Project screenshot as a lightbox trigger (Hugo project-placeholder.html's
 * sibling, project-shot.html).
 *
 * The card shows a cropped preview; the dialog gets the uncropped,
 * width-bounded original so tapping it reveals the whole screen. Every screen
 * is cropped to the same ratio so the cards stay a uniform height.
 *
 * `fill`/`fill2x` are the crop sizes of the card preview; `full` mirrors
 * Hugo's "2400x" bound for originals wider than 2400 px.
 */
interface Props {
  lang: Lang;
  photo: string;
  alt?: string;
  caption: string;
  fill?: { width: number; height: number };
  fill2x?: { width: number; height: number };
  sizes?: string;
  priority?: boolean;
  frame?: boolean;
}

const {
  lang,
  photo,
  caption,
  fill = { width: 800, height: 450 },
  fill2x = { width: 1600, height: 900 },
  sizes = '(min-width: 672px) 672px, 100vw',
  priority = false,
  frame = true,
} = Astro.props;

const alt = Astro.props.alt ?? caption;
const source = getProjectImage(photo);

const thumb = await getImage({
  src: source,
  ...fill,
  fit: 'cover',
  position: 'center',
  format: 'webp',
  quality: 80,
});
const thumb2x = await getImage({
  src: source,
  ...fill2x,
  fit: 'cover',
  position: 'center',
  format: 'webp',
  quality: 80,
});
const mobileThumb = await getImage({
  src: source,
  width: Math.round(fill.width / 2),
  height: Math.round(fill.height / 2),
  fit: 'cover',
  position: 'center',
  format: 'webp',
  quality: 75,
});
// Hugo only resizes above the source width, so a smaller original stays whole.
const full =
  source.width > 2400
    ? await getImage({ src: source, width: 2400, format: 'webp', quality: 85 })
    : { src: source.src };
---

<button
  type="button"
  class:list={['shot group relative z-10 block w-full cursor-zoom-in overflow-hidden', frame && 'rounded-lg border border-line-raised']}
  data-lightbox-src={full.src}
  data-lightbox-alt={alt}
  data-lightbox-caption={caption}
  aria-label={t(lang, 'imageEnlarge', { title: caption })}
>
  <img
    src={thumb.src}
    srcset={`${mobileThumb.src} ${mobileThumb.options.width}w, ${thumb.src} ${thumb.options.width}w, ${thumb2x.src} ${thumb2x.options.width}w`}
    sizes={sizes}
    width={thumb.options.width}
    height={thumb.options.height}
    alt=""
    class="shot__img w-full object-cover"
    {...(priority ? { fetchpriority: 'high' } : { loading: 'lazy', decoding: 'async' })}
  />
  <span class="shot-zoom" aria-hidden="true">
    <Icon name="zoom-in" class="size-4" />
  </span>
</button>
