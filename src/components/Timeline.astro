---
import Pill from './Pill.astro';
import SectionHead from './SectionHead.astro';

import type { TimelineItem } from '../data/types';

/**
 * Education and experience list: left rail, dot activated by the timeline
 * IntersectionObserver (ported in Fase 6).
 */
interface Props {
  title: string;
  body?: string;
  items: TimelineItem[];
}

const { title, body, items } = Astro.props;
const rows = items.filter((item) => item.name);
---

{
  rows.length > 0 && (
    <section class="flow max-w-[40rem] mx-auto">
      {/* 40rem = the header island's visible width (42rem minus 1rem gutter each side). */}
      <SectionHead title={title} body={body} />
      <ol class="timeline mt-8 space-y-8">
        {rows.map((item) => (
          <li class="relative pl-8">
            <span class="timeline-dot" />
            <div class="space-y-1">
              <h3 class="type-title text-ink text-balance">{item.name}</h3>
              {(item.company || item.duration) && (
                <p class="type-meta">
                  {[item.company, item.duration].filter(Boolean).join(' · ')}
                </p>
              )}
            </div>
            {item.description && (
              <p class="type-body mt-4">{item.description}</p>
            )}
            {item.keypoints && item.keypoints.length > 0 && (
              <ul class="mt-4 flex gap-2 flex-wrap">
                {item.keypoints.map((keypoint) => (
                  <Pill text={keypoint} />
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
