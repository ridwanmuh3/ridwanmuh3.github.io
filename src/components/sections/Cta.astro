---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { getContent } from '../../data/index';
import { localizeHref } from '../../lib/url';

import type { Lang } from '../../config';

/**
 * Closing section (Hugo's sections/CTA.html): headline, contact button, and
 * the social list with the WhatsApp row in accent colour.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { sections, socials } = getContent(lang);
const cta = sections.cta;
const href = cta.cta_href && !cta.cta_href.startsWith('http')
  ? localizeHref(lang, cta.cta_href)
  : cta.cta_href;
---

{
  cta.body && (
    <section class="rule-draw flow-lead flow-end pt-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <div>
          <SectionHead title={cta.title ?? "// Let's Work Together"} body={cta.body} />
          {cta.cta_label && (
            <div class="mt-8">
              <a href={href} class="btn-accent inline-block px-6 py-4">
                {cta.cta_label}
              </a>
            </div>
          )}
        </div>
        <ul class="space-y-2">
          {socials.map(
            (social) =>
              social.href &&
              social.icon && (
                <li>
                  <a
                    href={social.href}
                    rel="me noopener"
                    class:list={[
                      'group flex items-center gap-3 py-2 transition-colors hover:text-accent',
                      social.icon === 'brand-whatsapp' ? 'text-accent' : 'text-ink-body',
                    ]}
                  >
                    <Icon name={social.icon} class="size-5" />
                    <span class="type-title">{social.label ?? social.icon}</span>
                    <span class="ms-auto">
                      <Icon name="arrow-up-right" class="size-4" />
                    </span>
                  </a>
                </li>
              ),
          )}
        </ul>
      </div>
    </section>
  )
}
