---
import ProjectCard from '../ProjectCard.astro';
import SectionHead from '../SectionHead.astro';
import { getContent } from '../../data/index';
import { t } from '../../i18n/ui';
import { localizeHref } from '../../lib/url';

import type { Lang } from '../../config';

/**
 * Home projects teaser: the four newest by date, everything else stays on the
 * projects list (Hugo's sections/projects.html).
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { sections, projects } = getContent(lang);

const featured = [...projects]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 4);
---

{
  featured.length > 0 && (
    <section class="flow-lead">
      <SectionHead title={sections.projects.title ?? '// Featured Projects'} body={sections.projects.body} />
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {featured.map((project) => (
          <ProjectCard lang={lang} project={project} />
        ))}
      </div>
      <div class="w-full flex justify-center pt-8">
        <a
          class="btn-accent w-fit inline-block whitespace-nowrap text-sm px-3 py-3 sm:px-4 sm:py-1.5 max-sm:order-4 max-sm:basis-full max-sm:mt-2 max-sm:text-center cursor-pointer"
          href={localizeHref(lang, '/projects/')}
        >
          {t(lang, 'seeMore')}
        </a>
      </div>
    </section>
  )
}
