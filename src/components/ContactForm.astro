---
import { siteConfig } from '../config';
import { t } from '../i18n/ui';

import type { Lang } from '../config';

/**
 * Contact form markup (Hugo's `components/contact-form.html`).
 *
 * Validation and submission live in `scripts/contact-form.ts`; Turnstile keeps
 * its own inline loader because it is third-party. Renders nothing when the
 * endpoint is empty, exactly like Hugo's `with $c.endpoint`.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { endpoint, turnstileSiteKey } = siteConfig.contact;
---

{
  endpoint && (
    <section>
      <form
        class="contact-form space-y-4"
        novalidate
        action={endpoint}
        method="post"
        data-msg-sent={t(lang, 'contactSent')}
        data-msg-error={t(lang, 'contactError')}
        data-msg-rate-limited={t(lang, 'contactRateLimited')}
        data-msg-sending={t(lang, 'contactSending')}
        data-err-name={t(lang, 'contactInvalidName')}
        data-err-email={t(lang, 'contactInvalidEmail')}
        data-err-message={t(lang, 'contactInvalidMessage')}
      >
        {/* written by the script at page load, or the Worker's time-on-form check is meaningless */}
        <input type="hidden" name="t" value="" />

        <div class="sr-only" aria-hidden="true">
          <label for="cf-company">Company</label>
          <input type="text" id="cf-company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <div class="space-y-2">
          <label for="cf-name" class="type-label text-ink-muted block">
            {t(lang, 'contactName')}
          </label>
          <input
            class="field"
            type="text"
            id="cf-name"
            name="name"
            maxlength="100"
            autocomplete="name"
            aria-describedby="cf-name-error"
            required
          />
          <p id="cf-name-error" class="type-meta text-danger" hidden />
        </div>

        <div class="space-y-2">
          <label for="cf-email" class="type-label text-ink-muted block">
            {t(lang, 'contactEmail')}
          </label>
          <input
            class="field"
            type="email"
            id="cf-email"
            name="email"
            maxlength="254"
            autocomplete="email"
            inputmode="email"
            aria-describedby="cf-email-error"
            required
          />
          <p id="cf-email-error" class="type-meta text-danger" hidden />
        </div>

        <div class="space-y-2">
          <label for="cf-message" class="type-label text-ink-muted block">
            {t(lang, 'contactMessage')}
          </label>
          <textarea
            class="field resize-y min-h-36"
            id="cf-message"
            name="message"
            rows="6"
            minlength="10"
            maxlength="5000"
            placeholder={t(lang, 'contactMessagePlaceholder')}
            aria-describedby="cf-message-error"
            required
          />
          <p id="cf-message-error" class="type-meta text-danger" hidden />
        </div>

        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-appearance="interaction-only" />

        <div class="pt-2">
          <button type="submit" class="contact-submit btn-accent inline-block px-6 py-4">
            {t(lang, 'contactSend')}
          </button>
        </div>

        <noscript>
          <p class="type-body text-danger">{t(lang, 'contactNeedsJs')}</p>
        </noscript>
      </form>

      <p class="contact-status type-body mt-4" role="status" aria-live="polite" />
    </section>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer is:inline></script>
    <script>
      import { initContactForm } from '../scripts/contact-form';

      initContactForm();
    </script>
  )
}
