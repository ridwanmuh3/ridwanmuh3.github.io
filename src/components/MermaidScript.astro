<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    darkMode: true,
    fontFamily: "'Geist Mono', ui-monospace, monospace",
    themeVariables: {
      background: '#0a0a0a',
      primaryColor: '#27272a',
      primaryTextColor: '#e4e4e7',
      primaryBorderColor: '#3f3f46',
      secondaryColor: '#18181b',
      tertiaryColor: '#18181b',
      mainBkg: '#27272a',
      nodeBorder: '#3f3f46',
      nodeTextColor: '#e4e4e7',
      lineColor: '#71717a',
      textColor: '#d4d4d8',
      titleColor: '#fafafa',
      edgeLabelBackground: '#18181b',
      clusterBkg: '#18181b',
      clusterBorder: '#3f3f46',
      actorBkg: '#27272a',
      actorBorder: '#3f3f46',
      actorTextColor: '#e4e4e7',
      actorLineColor: '#3f3f46',
      signalColor: '#a1a1aa',
      signalTextColor: '#d4d4d8',
      labelBoxBkgColor: '#27272a',
      labelBoxBorderColor: '#3f3f46',
      labelTextColor: '#e4e4e7',
      loopTextColor: '#d4d4d8',
      noteBkgColor: '#27272a',
      noteBorderColor: '#3f3f46',
      noteTextColor: '#e4e4e7',
    },
  });
  await mermaid.run();

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const zoomLabel = dialog?.dataset.diagramZoomLabel ?? '';
  document.querySelectorAll<SVGSVGElement>('.prose-article .mermaid svg').forEach((svg) => {
    const pre = svg.closest('.mermaid');
    if (!pre) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'mermaid-zoom';
    button.setAttribute('aria-label', zoomLabel);
    svg.replaceWith(button);
    button.append(svg);
    button.addEventListener('click', () => {
      const viewer = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
      if (!viewer) return;
      const image = viewer.querySelector<HTMLImageElement>('[data-lightbox-img]');
      if (image) image.hidden = true;
      viewer.dispatchEvent(new CustomEvent('diagram-open', { detail: { button, svg } }));
    });
  });
</script>
