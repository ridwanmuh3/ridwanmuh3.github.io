---
import Icon from './Icon.astro';
import LangSwitcher from './LangSwitcher.astro';
import { t } from '../i18n/ui';
import { localizeHref } from '../lib/url';
import { siteConfig, type Lang } from '../config';

/**
 * Sticky header island. Menu and CTA are hidden below 40rem until the toggle
 * script (Fase 6) sets `aria-expanded`; the `<noscript>` style in BaseLayout
 * shows them when scripting is off.
 */
interface Props {
  lang: Lang;
  /** Current page's translation URL, when one exists. */
  translation?: string;
}

const { lang, translation } = Astro.props;
const homeHref = localizeHref(lang, '/');
const contactHref = localizeHref(lang, '/contact/');
const nav = siteConfig.locales[lang].nav;
---

<header class="sticky top-[max(1rem,env(safe-area-inset-top))] z-50 mb-4">
  <div class="mx-auto max-w-2xl w-full gutter">
    <div class="header-island surface-raised w-full rounded-lg">
      <nav
        class="site-nav flex flex-wrap items-center gap-x-3 px-4 py-2 sm:grid sm:grid-cols-[1fr_auto_1fr] sm:gap-x-4"
        aria-label={t(lang, 'navMain')}
      >
        <a
          href={homeHref}
          class="order-1 max-sm:me-auto sm:justify-self-start"
          aria-label={t(lang, 'navHome', { name: siteConfig.fullname })}
        >
          <span
            class="block bg-linear-to-b from-amber-300 from-10% to-amber-700 bg-clip-text font-header font-black text-3xl sm:text-4xl text-transparent leading-none"
            >R</span
          >
        </a>

        <ul
          id="site-menu"
          class="site-menu order-3 w-[calc(100%+2rem)] -mx-4 mt-2 px-4 flex flex-col border-t border-line text-sm font-header sm:order-2 sm:mt-0 sm:w-auto sm:mx-0 sm:px-0 sm:border-0 sm:flex-row sm:items-center sm:gap-6 sm:justify-self-center"
        >
          {
            nav.map((item) => (
              <li>
                <a href={localizeHref(lang, item.href)} class="link-quiet block py-3 sm:py-0">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="max-sm:contents sm:order-3 sm:flex sm:items-center sm:gap-2 sm:justify-self-end">
          <LangSwitcher lang={lang} href={translation} />
          <a
            href={contactHref}
            class="site-cta btn-accent inline-block whitespace-nowrap text-sm px-3 py-3 sm:px-4 sm:py-1.5 max-sm:order-4 max-sm:basis-full max-sm:mt-2 max-sm:text-center"
          >
            {t(lang, 'hireMe')}
          </a>
          <button
            type="button"
            class="site-nav-toggle link-quiet -me-2 inline-flex items-center justify-center p-3 max-sm:order-2 sm:hidden cursor-pointer"
            aria-controls="site-menu"
            aria-expanded="false"
            aria-label={t(lang, 'navMenu')}
          >
            <span class="icon-open inline-flex"><Icon name="menu" class="size-5" /></span>
            <span class="icon-close inline-flex"><Icon name="close" class="size-5" /></span>
          </button>
        </div>
      </nav>
    </div>
  </div>
</header>
