---
import { getLocalizedEntries, sortByDateDesc } from '../../../lib/content';
import { PAGE_SIZE } from '../../../lib/pagination';
import ProjectsList from '../../../views/ProjectsList.astro';

/** `/projects/page/N/` for N ≥ 2; page 1 lives at the list root. */
export async function getStaticPaths() {
  const entries = sortByDateDesc(await getLocalizedEntries('projects', 'en'));
  const totalPages = Math.ceil(entries.length / PAGE_SIZE);
  const paths = [];
  for (let number = 2; number <= totalPages; number += 1) {
    paths.push({ params: { page: String(number) } });
  }
  return paths;
}

const { page } = Astro.params as { page: string };
---

<ProjectsList lang="en" current={Number(page)} />
