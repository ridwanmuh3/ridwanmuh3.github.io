---
import { getCollection } from 'astro:content';

import { isPublished, slugFromId } from '../../lib/content';
import BlogDetail from '../../views/BlogDetail.astro';

import type { CollectionEntry } from 'astro:content';

/** `/blogs/<slug>/` for English (root locale). */
export async function getStaticPaths() {
  const entries = await getCollection('blog', isPublished);
  return entries
    .filter((entry) => entry.id.startsWith('en/'))
    .map((entry) => ({ params: { slug: slugFromId(entry.id) }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
---

<BlogDetail entry={entry} lang="en" />
