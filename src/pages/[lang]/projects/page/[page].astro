---
import { getLocalizedEntries, sortByDateDesc } from '../../../../lib/content';
import { PAGE_SIZE } from '../../../../lib/pagination';
import ProjectsList from '../../../../views/ProjectsList.astro';
import { DEFAULT_LOCALE, locales } from '../../../../config';

/** `/id/projects/page/N/` for N ≥ 2; page 1 lives at the list root. */
export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales.filter((locale) => locale !== DEFAULT_LOCALE)) {
    const entries = sortByDateDesc(await getLocalizedEntries('projects', lang));
    const totalPages = Math.ceil(entries.length / PAGE_SIZE);
    for (let number = 2; number <= totalPages; number += 1) {
      paths.push({ params: { lang, page: String(number) } });
    }
  }
  return paths;
}

const { lang, page } = Astro.params as { lang: 'id'; page: string };
---

<ProjectsList lang={lang} current={Number(page)} />
