# Hugo build output
/public/
/resources/_gen/
.hugo_build.lock

# Generated by Hugo's buildStats, consumed by the Tailwind cachebuster.
# Regenerated on every build, so it should not be tracked.
hugo_stats.json

# Node
/node_modules/

# Cloudflare Worker. `.dev.vars` holds the live Resend and Turnstile secrets for
# `wrangler dev` and must never be committed; `.dev.vars.example` is tracked.
/workers/*/node_modules/
/workers/*/.wrangler/
.dev.vars

# AI coding agents. The repo is public; none of this is the site, and it is
# either machine-specific or personal. PRODUCT.md is here because it quotes
# self-assessment and job-search positioning — drop that line to version it.
# The unused entries are pre-emptive, so switching tools leaks nothing.
.claude/
.impeccable/
PRODUCT.md
CLAUDE.md
AGENTS.md
.cursor/
.cursorrules
.windsurfrules
.clinerules
.roo/
.continue/
.codeium/
.aider*
.gemini/
.opencode/
.mcp.json
.github/copilot-instructions.md

# OS
.DS_Store
Thumbs.db
