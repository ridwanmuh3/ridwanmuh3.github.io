# Copy to `.dev.vars` (gitignored) for `npx wrangler dev`. Never put real
# secrets here — use `wrangler secret put` in production.
#
# TURNSTILE_SECRET_KEY is Cloudflare's always-passes test secret; pair it with
# the matching test site key in hugo.toml:
#   params.contact.turnstileSiteKey = "1x00000000000000000000AA"

RESEND_API_KEY = "re_replace_me"
TURNSTILE_SECRET_KEY = "1x0000000000000000000000000000000AA"
