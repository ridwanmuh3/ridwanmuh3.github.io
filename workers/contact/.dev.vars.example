# Copy to `.dev.vars` (gitignored) for `npx wrangler dev`.
#
# TURNSTILE_SECRET_KEY below is Cloudflare's published always-passes test
# secret, so the whole pipeline is exercisable locally without a real challenge.
# Pair it with the matching test site key in hugo.toml:
#   params.contact.turnstileSiteKey = "1x00000000000000000000AA"
#
# Never put the real secrets in this file — put them in .dev.vars, and in
# production use `npx wrangler secret put <NAME>`.

RESEND_API_KEY = "re_replace_me"
TURNSTILE_SECRET_KEY = "1x0000000000000000000000000000000AA"
